{
  "name": "league-replay-analyser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Leetify-style performance analytics for League of Legends, built on Riot match-v5.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "cli": "node --disable-warning=ExperimentalWarning --import tsx src/cli.ts",
    "analyze": "npm run --silent cli -- analyze",
    "crawl": "npm run --silent cli -- crawl",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "serve": "npm run --silent cli -- serve",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts && vite build --config web/vite.config.ts --mode single"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^8.3.3",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
