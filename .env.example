# Get a key at https://developer.riotgames.com (dev keys expire every 24h)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Platform of the accounts you analyze: na1, euw1, eun1, kr, jp1, br1, la1, la2, oc1, tr1, ru, me1, ph2, sg2, th2, tw2, vn2
RIOT_PLATFORM=na1
# "count:seconds" pairs. Defaults match a development key; raise for a production key.
RIOT_RATE_LIMITS=20:1,100:120
DB_PATH=data/lol.db
